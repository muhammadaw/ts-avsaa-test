datasource db {
  provider = "sqlite"
  url      = "file:../vouchers.db"
}

generator client {
  provider = "prisma-client-js"
}

model Voucher {
  id            Int      @id @default(autoincrement())
  crew_name     String
  crew_id       String
  flight_number String
  flight_date   String   // Stored as ISO 8601 YYYY-MM-DD
  aircraft_type String
  seat1         String
  seat2         String
  seat3         String
  created_at    DateTime @default(now())

  @@unique([flight_number, flight_date])
  @@map("vouchers")
}
